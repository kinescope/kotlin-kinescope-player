<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <View
        android:id="@+id/captions_search_row_indicator"
        android:layout_width="3dp"
        android:layout_height="@dimen/kinescope_captions_search_indicator_height"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_captions_search_playing_indicator"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/captions_search_row_text_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:paddingEnd="12dp"
        android:textAppearance="@style/Regular.14.White"
        tools:text="Sample caption line" />

    <TextView
        android:id="@+id/captions_search_row_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:includeFontPadding="false"
        android:textAppearance="@style/Regular.14.WhiteSecondary"
        android:visibility="gone"
        tools:text="12:49"
        tools:visibility="visible" />

</LinearLayout>
