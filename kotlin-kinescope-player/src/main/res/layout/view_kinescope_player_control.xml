    </LinearLayout>

    <TextView
        android:id="@+id/scrub_chapter_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:elevation="12dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:maxWidth="@dimen/kinescope_caption_max_width"
        android:paddingLeft="@dimen/kinescope_caption_padding_horizontal"
        android:paddingTop="@dimen/kinescope_caption_padding_vertical"
