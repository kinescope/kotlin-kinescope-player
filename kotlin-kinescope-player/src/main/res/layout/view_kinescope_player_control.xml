        android:paddingBottom="@dimen/kinescope_caption_padding_vertical"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Chapter 1"
        tools:visibility="visible" />

</FrameLayout>
