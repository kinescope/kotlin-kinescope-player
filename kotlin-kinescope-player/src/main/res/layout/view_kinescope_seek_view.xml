<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clickable="false"
    android:focusable="false">

    <FrameLayout
        android:id="@+id/seek_feedback_back"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical|start"
        android:clipChildren="false"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:id="@+id/seek_feedback_back_hemisphere_clip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical|start"
            android:clipChildren="true">

            <View
                android:id="@+id/seek_feedback_back_hemisphere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_seek_feedback_circle" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/seek_feedback_back_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <io.kinescope.sdk.view.SeekDirectionIconView
                android:id="@+id/seek_feedback_back_icon"
                android:layout_width="@dimen/kinescope_seek_feedback_icon_width"
                android:layout_height="@dimen/kinescope_seek_feedback_icon_height"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/seek_feedback_back_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kinescope_seek_feedback_label_gap"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="10 sec" />

        </LinearLayout>

    </FrameLayout>

    <FrameLayout
        android:id="@+id/seek_feedback_forward"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical|end"
        android:clipChildren="false"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/seek_feedback_forward_hemisphere_clip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical|end"
            android:clipChildren="true">

            <View
                android:id="@+id/seek_feedback_forward_hemisphere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_seek_feedback_circle" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/seek_feedback_forward_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <io.kinescope.sdk.view.SeekDirectionIconView
                android:id="@+id/seek_feedback_forward_icon"
                android:layout_width="@dimen/kinescope_seek_feedback_icon_width"
                android:layout_height="@dimen/kinescope_seek_feedback_icon_height"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/seek_feedback_forward_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kinescope_seek_feedback_label_gap"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="10 sec" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
