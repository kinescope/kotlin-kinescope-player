<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kinescope_cast_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/kinescope_cast_device_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/Regular.14.White"
            tools:text="Casting to SHIELD" />

        <ImageButton
            android:id="@+id/kinescope_cast_play_pause"
            android:layout_width="@dimen/kinescope_play_pause_size"
            android:layout_height="@dimen/kinescope_play_pause_size"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_play_pause_button"
            android:contentDescription="@string/player_play"
            android:padding="@dimen/kinescope_play_pause_glyph_inset"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_center_play_glyph" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/kinescope_cast_position_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Regular.14.White"
                tools:text="0:00" />

            <SeekBar
                android:id="@+id/kinescope_cast_seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@color/kinescope_primary_color"
                android:thumbTint="@color/kinescope_primary_color" />

            <TextView
                android:id="@+id/kinescope_cast_duration_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Regular.14.White"
                tools:text="10:24" />

        </LinearLayout>

        <TextView
            android:id="@+id/kinescope_cast_stop_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_cast_stop_button"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="@string/player_cast_stop"
            android:textAppearance="@style/Medium.14.White" />

    </LinearLayout>

</FrameLayout>
