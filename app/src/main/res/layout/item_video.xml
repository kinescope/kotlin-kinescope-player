<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_playlist_item"
    android:gravity="top"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:minWidth="24dp">

        <TextView
            android:id="@+id/tv_index"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical|center_horizontal"
            android:minWidth="24dp"
            android:includeFontPadding="false"
            android:textColor="@color/playlist_text_secondary"
            android:textSize="14sp"
            tools:text="1" />

        <ImageView
            android:id="@+id/iv_playing"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:src="@drawable/ic_playlist_play"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="56dp"
        android:layout_marginStart="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_playlist_thumbnail"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/PlaylistThumbnailShape" />

        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_playlist_duration_badge"
            android:includeFontPadding="false"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="48:23"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:maxHeight="56dp"
        android:maxLines="2"
        android:textColor="@color/playlist_text_primary"
        android:textSize="14sp"
        tools:text="Never lose your video again" />

    <ImageButton
        android:id="@+id/btn_copy_link"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/playlist_copy_link"
        android:scaleType="centerInside"
        android:src="@drawable/ic_copy_link" />

</LinearLayout>
