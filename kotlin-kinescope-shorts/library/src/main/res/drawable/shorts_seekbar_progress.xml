<?xml version="1.0" encoding="utf-8"?>
<!-- Figma Player Timeline: 4dp bar, track #FFFFFF52, progress #6161FC, radius 2dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/shorts_seekbar_background" />
        </shape>
    </item>

    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="@color/shorts_seekbar_secondary" />
            </shape>
        </clip>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="@color/shorts_seekbar_progress" />
            </shape>
        </clip>
    </item>
</layer-list>
